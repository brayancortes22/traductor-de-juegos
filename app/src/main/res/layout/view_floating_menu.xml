<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_root"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_menu"
    android:orientation="vertical"
    android:padding="8dp"
    android:elevation="14dp">

    <!-- Header / Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/menu_title"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="4dp" />

        <ImageButton
            android:id="@+id/btn_menu_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_menu_item"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/btn_close" />
    </LinearLayout>

    <!-- Option 1: Full Screen -->
    <LinearLayout
        android:id="@+id/btn_mode_full"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:background="@drawable/bg_menu_item">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_translate" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/mode_full_screen"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Option 2: Partial Crop -->
    <LinearLayout
        android:id="@+id/btn_mode_crop"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:background="@drawable/bg_menu_item">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_crop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/mode_partial_crop"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_cyan"
        android:layout_marginVertical="4dp" />

    <!-- Toggle 1: Auto-Dialogue (NPCs) -->
    <LinearLayout
        android:id="@+id/btn_mode_chat"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:background="@drawable/bg_menu_item">

        <ImageView
            android:id="@+id/iv_chat_indicator"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chat" />

        <TextView
            android:id="@+id/tv_chat_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="💬 Auto-Diálogo"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Toggle 2: Real-time Auto-Scan -->
    <LinearLayout
        android:id="@+id/btn_mode_realtime"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:background="@drawable/bg_menu_item">

        <ImageView
            android:id="@+id/iv_realtime_indicator"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_realtime" />

        <TextView
            android:id="@+id/tv_realtime_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/mode_realtime_toggle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Toggle 3: HUD Filter -->
    <LinearLayout
        android:id="@+id/btn_toggle_filter"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:background="@drawable/bg_menu_item">

        <ImageView
            android:id="@+id/iv_filter_indicator"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_crop"
            app:tint="#38BDF8" />

        <TextView
            android:id="@+id/tv_filter_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/menu_filter_toggle"
            android:textColor="#38BDF8"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
